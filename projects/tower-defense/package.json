{
  "name": "inkfold",
  "version": "0.1.0",
  "description": "Inkfold: a papercraft tower-defence vertical slice (TypeScript + Canvas 2D).",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4317 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:boot": "node scripts/e2e/boot.mjs",
    "test:audio": "node scripts/e2e/audio.mjs",
    "test:playthrough": "node scripts/e2e/playthrough.mjs",
    "test:parity": "vitest run --config scripts/e2e/parity/vitest.config.ts",
    "test:determinism": "node scripts/e2e/determinism.mjs",
    "test:screens": "node scripts/e2e/screenshots.mjs",
    "test:perf": "node scripts/e2e/perf.mjs",
    "check:size": "node scripts/check-size.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:strict": "node scripts/verify.mjs --strict"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.63.0",
    "typescript": "6.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
