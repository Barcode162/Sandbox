{
  "name": "scroll-showcase",
  "version": "0.0.0",
  "description": "Bent Light: a scroll-driven animation piece in six scenes, with the tests that define what correct animation means for it.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "bake": "node scripts/bake-static.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:static": "node tests/static/check-static.mjs",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:e2e": "playwright test --project=e2e",
    "test:perf": "playwright test --project=perf --workers=1",
    "check:size": "node scripts/check-size.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "verify": "node scripts/verify.mjs",
    "lighthouse": "CHROME_PATH=${CHROME_PATH:-/opt/pw-browsers/chromium} npx --yes lighthouse@13.6.0 http://127.0.0.1:${PORT:-4173}/ --quiet --chrome-flags='--headless=new --no-sandbox' --only-categories=performance,accessibility,best-practices --output=json --output-path=evidence-local/lighthouse.json",
    "test": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "axe-core": "4.14.1",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.2"
  }
}
