{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": false,
    "noImplicitThis": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "site/js/**/*.js",
    "site/js/**/*.d.ts",
    "dev/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.js",
    "tests/**/*.js",
    "tests/**/*.mjs",
    "playwright.config.js"
  ],
  "exclude": ["node_modules", "test-results", "playwright-report", "evidence-local"]
}
